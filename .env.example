# ─── Aurora Messenger ────────────────────────────────────────────────
# Скопируйте этот файл в .env.local и заполните своими значениями.
# Supabase → Project Settings → API

VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Необязательно: свой TURN-сервер для звонков между разными сетями.
# Публичный STUN работает всегда, TURN нужен для симметричных NAT / мобильного интернета.
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=