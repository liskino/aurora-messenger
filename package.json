{
  "name": "aurora-messenger",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Aurora — быстрый защищённый мессенджер с E2E-шифрованием, работает из любой сети",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173",
    "bench": "node bench/run.mjs",
    "bench:browser": "vite build --config vite.bench.config.ts && node bench/browser.mjs",
    "bench:smoke": "npm run build && node bench/smoke.mjs",
    "bench:all": "npm run bench && npm run bench:browser && npm run bench:smoke"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "idb": "^8.0.0",
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^26.6.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
